# ─────────────────────────────────────────────────────────────
# LATUSHYA — Frontend Environment Variables
# Copy to .env.local for local overrides.
# ─────────────────────────────────────────────────────────────

# ─── Backend API URL ─────────────────────────────────────────
# In development (npm run dev), leave blank: Vite proxy forwards
# relative /api/* to http://localhost:5000 automatically (see vite.config.js).
#
# In production (Vercel), VITE_API_URL is STRICTLY REQUIRED.
# If unset in production, form submissions fail closed (BACKEND_NOT_CONFIGURED)
# to prevent unpersisted leads or untracked conversions:
# VITE_API_URL=https://your-backend.railway.app
VITE_API_URL=

# ─── Google Sheets Live Leads Webhook URL (Legacy / Reference Only) ───
# Webhook dispatch from client has been removed in favor of secure server-to-server sync.
VITE_LEADS_WEBHOOK_URL=https://script.google.com/macros/s/AKfycbxMvmDzqdzbES3P-yVbAncAkM0rcahGc-aAJAc7qK6TM6BfcLit_zPbwe69YWYLIGW4/exec

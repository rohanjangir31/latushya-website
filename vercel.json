{
  "version": 2,
  "name": "latushya",
  "framework": "vite",
  "buildCommand": "npm run build",
  "outputDirectory": "dist",
  "installCommand": "npm install",
  "routes": [
    {
      "src": "^/(category|product|admiralbet-polska-com|pacific-spins-casinonz-com|rocketcasinoaustralia-org|wp-content|wp-admin|wp-includes|wp-json)(/.*)?$",
      "status": 410,
      "dest": "/410.html",
      "headers": {
        "X-Robots-Tag": "noindex, nofollow",
        "Cache-Control": "public, max-age=86400"
      }
    },
    {
      "src": "^/(.*)(winbeatz|thunder-coins|paripesabangladesh|playregalcasino|spinyoocasino|metalcasino|spinaniacasino|stanleybet|coinpoker)(.*)$",
      "status": 410,
      "dest": "/410.html",
      "headers": {
        "X-Robots-Tag": "noindex, nofollow",
        "Cache-Control": "public, max-age=86400"
      }
    },
    {
      "handle": "filesystem"
    },
    {
      "src": "^/(about|services|portfolio|wardrobes|materials|contact|lp)(/.*)?$",
      "dest": "/index.html"
    },
    {
      "src": "^/collections(/[a-zA-Z0-9_-]+)?(/.*)?$",
      "dest": "/index.html"
    },
    {
      "src": "^/?$",
      "dest": "/index.html"
    },
    {
      "src": "/(.*)",
      "status": 404,
      "dest": "/404.html",
      "headers": {
        "X-Robots-Tag": "noindex, nofollow"
      }
    }
  ],
  "headers": [
    {
      "source": "/(.*)",
      "headers": [
        { "key": "Cache-Control", "value": "no-cache, no-store, must-revalidate" },
        { "key": "X-Content-Type-Options", "value": "nosniff" },
        { "key": "X-Frame-Options", "value": "DENY" },
        { "key": "X-XSS-Protection", "value": "1; mode=block" },
        { "key": "Referrer-Policy", "value": "strict-origin-when-cross-origin" }
      ]
    },
    {
      "source": "/assets/(.*)",
      "headers": [
        { "key": "Cache-Control", "value": "public, max-age=31536000, immutable" }
      ]
    }
  ]
}
